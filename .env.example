# ==============================================================================
# EDITORIAL CODE - ENVIRONMENT VARIABLES & AI PROVIDER CONFIGURATION
# ==============================================================================
# Copy this file to '.env' for local development or configure these variables
# in your deployment platform (Vercel, Railway, Render, Google Cloud Run, Docker).
#
# IMPORTANT: Never commit actual API keys to GitHub or public repositories.
# ==============================================================================

# Server Port (Default is 3000; Cloud Run / Render inject this automatically)
PORT=3000

# Application Environment ('development' or 'production')
NODE_ENV=production

# App Public URL
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI (Default Primary Provider)
# Obtain at: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM / 1,500 RPD permanent
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. GROQ (LPU In-Memory Inference - Ultra-Fast Fallback)
# Obtain at: https://console.groq.com/keys
# Free tier: 30 RPM / 14,400 RPD permanent (Llama 3.3 70B, Llama 3.1 8B, Mixtral)
# ------------------------------------------------------------------------------
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 3. CEREBRAS (Wafer-Scale Inference - 1,800 t/s)
# Obtain at: https://cloud.cerebras.ai/
# Free tier: 30 RPM / 60,000 TPM rolling minute (Llama 3.1 70B & 8B)
# ------------------------------------------------------------------------------
CEREBRAS_API_KEY=""

# ------------------------------------------------------------------------------
# 4. OPENROUTER (Free Multi-Model Hub)
# Obtain at: https://openrouter.ai/keys
# Free tier: Access to :free models (Llama 3.3, Mistral Small, Qwen 2.5 - 200 req/day)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=""

# ------------------------------------------------------------------------------
# 5. DEEPSEEK (DeepSeek V3 & DeepSeek R1)
# Obtain at: https://platform.deepseek.com/api_keys
# Free tier: Promotional initial credits upon registration
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=""

# ------------------------------------------------------------------------------
# 6. MISTRAL AI (La Plateforme)
# Obtain at: https://console.mistral.ai/api-keys/
# Free tier: Experimentation tier (1 RPS free) (Mistral Small, Codestral)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=""

# ------------------------------------------------------------------------------
# 7. QWEN OFFICIAL API (Alibaba Cloud DashScope)
# Obtain at: https://dashscope.console.aliyun.com/apiKey
# Free tier: 1,000,000 promotional free tokens upon sign-up (Qwen 2.5 72B, Qwen-Turbo)
# ------------------------------------------------------------------------------
QWEN_API_KEY=""

# ------------------------------------------------------------------------------
# 8. HUGGING FACE (Inference API)
# Obtain at: https://huggingface.co/settings/tokens (Create "Read" Access Token)
# Free tier: Serverless free inference on open weights (Qwen 2.5 72B Instruct)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY=""
